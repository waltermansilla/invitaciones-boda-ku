            "// --- NUESTRA HISTORIA (estilo Micaela & Joaquin: simple) ---": "",
            "_comment": "variant simple: titulo + paragraphs (sin fotos ni subtitulos).",
            "type": "ourStory",
            "id": "our-story",
            "bgColor": "background",
            "style": {
                "title": {
                    "enabled": false,
                    "sizePx": 39,
                    "weight": 500,
                    "letterSpacing": 0.5
                },
                "paragraphs": {
                    "textAlign": "start",
